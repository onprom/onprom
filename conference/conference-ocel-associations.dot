digraph Associations {
 graph [rankdir=LR, bgcolor=white, pad=.25, nodesep=.42, ranksep=.75, fontname="DejaVu Sans", labelloc=t, fontsize=20, label="Conference model → OCEL 2.0 associations"];
 node [shape=plain, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9, color="#475569", arrowsize=.7];
 subgraph cluster_domain {label="DOMAIN RELATIONSHIPS"; style=rounded; color="#64748b"; fontsize=14;
  Paper [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>Paper</B></TD></TR></TABLE>>];
  Conference [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>Conference</B></TD></TR></TABLE>>];
  Person [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>Person</B></TD></TR></TABLE>>];
  Assignment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>Assignment</B></TD></TR></TABLE>>];
  AdditionalAssignment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD BGCOLOR="#bfdbfe"><B>AdditionalAssignment</B><BR/><FONT POINT-SIZE="9">subclass of Assignment</FONT></TD></TR></TABLE>>];
  Review [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>Review</B></TD></TR></TABLE>>];
  DecidedPaper [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD BGCOLOR="#dbeafe"><B>DecidedPaper</B><BR/><FONT POINT-SIZE="9">subclass of Paper</FONT></TD></TR></TABLE>>];
  Paper -> Conference [dir=both, arrowhead=none, arrowtail=none, label="submittedTo"];
  Paper -> Person [dir=both, arrowhead=none, arrowtail=none, label="submittedBy"];
  Paper -> Assignment [dir=both, arrowhead=none, arrowtail=none, label="assignment"];
  Assignment -> Person [dir=both, arrowhead=none, arrowtail=none, label="assignedTo"];
  AdditionalAssignment -> Person [dir=both, arrowhead=none, arrowtail=none, label="invitedBy"];
  Assignment -> Review [dir=both, arrowhead=none, arrowtail=none, label="leadsTo"];
  DecidedPaper -> Person [dir=both, arrowhead=none, arrowtail=none, label="notifiedBy"];
 }
 subgraph cluster_o2o {label="OCEL OBJECT–OBJECT: relatedTo ASSOCIATION CLASS"; style=rounded; color="#6d28d9"; fontsize=14;
  reltable [label=<<TABLE BORDER="1" CELLBORDER="1" CELLPADDING="5" COLOR="#6d28d9"><TR><TD COLSPAN="3" BGCOLOR="#ede9fe"><B>relatedTo</B></TD></TR><TR><TD><B>Source Object</B></TD><TD><B>Target Object</B></TD><TD><B>oQualifier</B></TD></TR><TR><TD>Paper</TD><TD>Conference</TD><TD>submitted-to</TD></TR><TR><TD>Paper</TD><TD>Person</TD><TD>submitted-by</TD></TR><TR><TD>Paper</TD><TD>Assignment</TD><TD>has-assignment</TD></TR><TR><TD>Assignment</TD><TD>Person</TD><TD>assigned-to</TD></TR><TR><TD>Assignment (AdditionalAssignment instance)</TD><TD>Person</TD><TD>invited-by</TD></TR></TABLE>>];
 }
 subgraph cluster_e2o {label="OCEL EVENT–OBJECT: corr ASSOCIATION CLASS"; style=rounded; color="#0e7490"; fontsize=14;
  corrtable [label=<<TABLE BORDER="1" CELLBORDER="1" CELLPADDING="5" COLOR="#0e7490"><TR><TD COLSPAN="3" BGCOLOR="#cffafe"><B>corr</B></TD></TR><TR><TD><B>Event</B></TD><TD><B>Object</B></TD><TD><B>eQualifier</B></TD></TR><TR><TD>MakeConference</TD><TD>Conference</TD><TD>conference</TD></TR><TR><TD>InviteReviewersStart / End</TD><TD>Paper</TD><TD>paper</TD></TR><TR><TD>InviteReviewersStart / End</TD><TD>Initial Assignment instances (not AdditionalAssignment)</TD><TD>assignment</TD></TR><TR><TD>InviteAdditionalReviewerStart / End</TD><TD>Assignment object whose domain individual is AdditionalAssignment</TD><TD>additional-assignment</TD></TR><TR><TD>InviteAdditionalReviewerStart / End</TD><TD>Person</TD><TD>inviter / invitee*</TD></TR><TR><TD>SubmitReview</TD><TD>Paper</TD><TD>reviewed-paper</TD></TR><TR><TD>SubmitReview</TD><TD>Assignment</TD><TD>assignment</TD></TR><TR><TD>SubmitReview</TD><TD>Person</TD><TD>reviewer</TD></TR><TR><TD>NotifyDecision</TD><TD>Paper</TD><TD>decided-paper</TD></TR><TR><TD>NotifyDecision</TD><TD>Person</TD><TD>notifier</TD></TR></TABLE>>];
 }
 note [shape=note, style=filled, fillcolor="#fff7ed", color="#c2410c", label="Important subtype/provenance point:\nAdditionalAssignment ⊑ Assignment. The OCEL Object\nis generated by the Assignment object mapping; an\nAdditionalAssignment instance reuses that same object IRI\nand Assignment Type. Only AdditionalAssignment instances\ngenerate InviteAdditionalReviewer events. The corr source\nmust be restricted to that same subset (e.g. by subtype\nmembership / invitedBy provenance), or it can create\ncorrelations to non-existent invitation events.\nThe invitee is identified retrospectively from\nAdditionalAssignment.assignedTo when get review X occurs."];
 reltable -> corrtable [style=invis]; corrtable -> note [style=invis];
}

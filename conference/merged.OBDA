target		<http://www.example.com/dolibarr/{v3}/{v0}> a log:Time . 
source		SELECT DISTINCT CAST(v1.case_id AS TEXT) AS "v0", CAST(v2.invite_acc AS TEXT) AS "v3"
			FROM (SELECT DISTINCT process_id AS conf_id, case_id FROM events) v1, (SELECT case_id, (ARRAY_AGG(time_timestamp ORDER BY time_timestamp ASC))[1] AS invite_start, (ARRAY_AGG(time_timestamp ORDER BY time_timestamp ASC))[2] AS invite_acc FROM events WHERE concept_name = 'invite reviewers' GROUP BY case_id) v2
			WHERE (CAST(v1.case_id AS TEXT) = CAST(v2.case_id AS TEXT) AND v1.case_id IS NOT NULL AND v2.case_id IS NOT NULL AND v2.invite_acc IS NOT NULL)
			


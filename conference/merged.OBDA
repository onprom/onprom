[MappingDeclaration] @collection [[
mappingId	ONPROM_MAPPING_1
target		<http://www.example.com/dolibarr/subReviewActivity/SubmitReview/{v0}> a log:Activity . 
source		SELECT DISTINCT ('http://www.example.org/conference/data/review/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v1.paper AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D') || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v1.reviewer AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v0"
			FROM (SELECT DISTINCT A.case_id AS paper, substring(B.attr_name FROM 'Result by Reviewer (.*)$') AS reviewer, A.time_timestamp, B.attr_value AS review_result  FROM events A INNER JOIN event_attributes B ON A.event_id = B.event_id WHERE B.attr_name LIKE 'Result by Reviewer %') v1
			WHERE (v1.paper IS NOT NULL AND v1.reviewer IS NOT NULL)
			

mappingId	ONPROM_MAPPING_2
target		<http://www.example.com/dolibarr/subReviewActivity/SubmitReview/{v0}> log:name "SubmitReview"^^xsd:string . 
source		SELECT DISTINCT ('http://www.example.org/conference/data/review/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v1.paper AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D') || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v1.reviewer AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v0"
			FROM (SELECT DISTINCT A.case_id AS paper, substring(B.attr_name FROM 'Result by Reviewer (.*)$') AS reviewer, A.time_timestamp, B.attr_value AS review_result  FROM events A INNER JOIN event_attributes B ON A.event_id = B.event_id WHERE B.attr_name LIKE 'Result by Reviewer %') v1
			WHERE (v1.paper IS NOT NULL AND v1.reviewer IS NOT NULL)
			

mappingId	ONPROM_MAPPING_3
target		<http://www.example.com/dolibarr/SubmitReview/{v0}/{v0}> log:observes <http://www.example.com/dolibarr/subReviewActivity/SubmitReview/{v0}> . 
source		SELECT DISTINCT ('http://www.example.org/conference/data/review/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v1.paper AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D') || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v1.reviewer AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v0"
			FROM (SELECT DISTINCT A.case_id AS paper, substring(B.attr_name FROM 'Result by Reviewer (.*)$') AS reviewer, A.time_timestamp, B.attr_value AS review_result  FROM events A INNER JOIN event_attributes B ON A.event_id = B.event_id WHERE B.attr_name LIKE 'Result by Reviewer %') v1
			WHERE (v1.paper IS NOT NULL AND v1.reviewer IS NOT NULL)
			

mappingId	ONPROM_MAPPING_4
target		<http://www.example.com/dolibarr/nameValue/{v4m9}/{v2m8}> a log:OAttrValue . 
source		SELECT DISTINCT v27."v2m8" AS "v2m8", v27."v4m9" AS "v4m9"
			FROM ((SELECT ('http://www.example.org/conference/data/person/Author_' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v1.case_id AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m8", ('Author of ' || CAST(v2.case_id AS TEXT)) AS "v4m9"
			FROM (SELECT DISTINCT case_id FROM events) v1, (SELECT DISTINCT case_id FROM events) v2
			WHERE (CAST(v1.case_id AS TEXT) = CAST(v2.case_id AS TEXT) AND v1.case_id IS NOT NULL AND v2.case_id IS NOT NULL)
			)UNION ALL 
			(SELECT ('http://www.example.org/conference/data/person/Author_' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v4.case_id AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m8", CAST(v5.person_id AS TEXT) AS "v4m9"
			FROM (SELECT DISTINCT case_id FROM events) v4, (SELECT person_id FROM (
			SELECT DISTINCT substring(attr_name FROM 'Result by Reviewer (.*)$') AS person_id
			FROM event_attributes
			WHERE attr_name LIKE 'Result by Reviewer %'
			UNION
			SELECT DISTINCT org_resource AS person_id
			FROM events
			WHERE org_resource IS NOT NULL
			) AS combined_persons) v5
			WHERE (('Author_' || CAST(v4.case_id AS TEXT)) = CAST(v5.person_id AS TEXT) AND v4.case_id IS NOT NULL AND v5.person_id IS NOT NULL)
			)UNION ALL 
			(SELECT ('http://www.example.org/conference/data/person/Author_' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v7.case_id AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m8", ('Inviter_' || v8."org_resource") AS "v4m9"
			FROM (SELECT DISTINCT case_id FROM events) v7, "events" v8
			WHERE (('Author_' || CAST(v7.case_id AS TEXT)) = v8."org_resource" AND v7.case_id IS NOT NULL AND v8."org_resource" IS NOT NULL AND 'invite additional reviewer' = v8."concept_name")
			)UNION ALL 
			(SELECT ('http://www.example.org/conference/data/person/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v10.person_id AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m8", ('Author of ' || CAST(v11.case_id AS TEXT)) AS "v4m9"
			FROM (SELECT person_id FROM (
			SELECT DISTINCT substring(attr_name FROM 'Result by Reviewer (.*)$') AS person_id
			FROM event_attributes
			WHERE attr_name LIKE 'Result by Reviewer %'
			UNION
			SELECT DISTINCT org_resource AS person_id
			FROM events
			WHERE org_resource IS NOT NULL
			) AS combined_persons) v10, (SELECT DISTINCT case_id FROM events) v11
			WHERE (CAST(v10.person_id AS TEXT) = ('Author_' || CAST(v11.case_id AS TEXT)) AND v10.person_id IS NOT NULL AND v11.case_id IS NOT NULL)
			)UNION ALL 
			(SELECT ('http://www.example.org/conference/data/person/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v13.person_id AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m8", CAST(v14.person_id AS TEXT) AS "v4m9"
			FROM (SELECT person_id FROM (
			SELECT DISTINCT substring(attr_name FROM 'Result by Reviewer (.*)$') AS person_id
			FROM event_attributes
			WHERE attr_name LIKE 'Result by Reviewer %'
			UNION
			SELECT DISTINCT org_resource AS person_id
			FROM events
			WHERE org_resource IS NOT NULL
			) AS combined_persons) v13, (SELECT person_id FROM (
			SELECT DISTINCT substring(attr_name FROM 'Result by Reviewer (.*)$') AS person_id
			FROM event_attributes
			WHERE attr_name LIKE 'Result by Reviewer %'
			UNION
			SELECT DISTINCT org_resource AS person_id
			FROM events
			WHERE org_resource IS NOT NULL
			) AS combined_persons) v14
			WHERE (CAST(v13.person_id AS TEXT) = CAST(v14.person_id AS TEXT) AND v13.person_id IS NOT NULL AND v14.person_id IS NOT NULL)
			)UNION ALL 
			(SELECT ('http://www.example.org/conference/data/person/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v16.person_id AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m8", ('Inviter_' || v17."org_resource") AS "v4m9"
			FROM (SELECT person_id FROM (
			SELECT DISTINCT substring(attr_name FROM 'Result by Reviewer (.*)$') AS person_id
			FROM event_attributes
			WHERE attr_name LIKE 'Result by Reviewer %'
			UNION
			SELECT DISTINCT org_resource AS person_id
			FROM events
			WHERE org_resource IS NOT NULL
			) AS combined_persons) v16, "events" v17
			WHERE (CAST(v16.person_id AS TEXT) = v17."org_resource" AND v16.person_id IS NOT NULL AND v17."org_resource" IS NOT NULL AND 'invite additional reviewer' = v17."concept_name")
			)UNION ALL 
			(SELECT ('http://www.example.org/conference/data/person/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(v19."org_resource", '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m8", ('Author of ' || CAST(v20.case_id AS TEXT)) AS "v4m9"
			FROM "events" v19, (SELECT DISTINCT case_id FROM events) v20
			WHERE (v19."org_resource" = ('Author_' || CAST(v20.case_id AS TEXT)) AND v19."org_resource" IS NOT NULL AND v20.case_id IS NOT NULL AND 'invite additional reviewer' = v19."concept_name")
			)UNION ALL 
			(SELECT ('http://www.example.org/conference/data/person/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(v22."org_resource", '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m8", CAST(v23.person_id AS TEXT) AS "v4m9"
			FROM "events" v22, (SELECT person_id FROM (
			SELECT DISTINCT substring(attr_name FROM 'Result by Reviewer (.*)$') AS person_id
			FROM event_attributes
			WHERE attr_name LIKE 'Result by Reviewer %'
			UNION
			SELECT DISTINCT org_resource AS person_id
			FROM events
			WHERE org_resource IS NOT NULL
			) AS combined_persons) v23
			WHERE (v22."org_resource" = CAST(v23.person_id AS TEXT) AND v22."org_resource" IS NOT NULL AND v23.person_id IS NOT NULL AND 'invite additional reviewer' = v22."concept_name")
			)UNION ALL 
			(SELECT ('http://www.example.org/conference/data/person/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(v25."org_resource", '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m8", ('Inviter_' || v25."org_resource") AS "v4m9"
			FROM "events" v25
			WHERE (v25."org_resource" IS NOT NULL AND 'invite additional reviewer' = v25."concept_name")
			)) v27
			

mappingId	ONPROM_MAPPING_5
target		<http://www.example.com/dolibarr/nameValue/{v4m9}/{v2m9}> log:oValue {v4m9}^^xsd:anyURI . 
source		SELECT DISTINCT v7."v2m9" AS "v2m9", v7."v4m9" AS "v4m9"
			FROM ((SELECT ('http://www.example.org/conference/data/person/Author_' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v1.case_id AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m9", ('Author of ' || CAST(v1.case_id AS TEXT)) AS "v4m9"
			FROM (SELECT DISTINCT case_id FROM events) v1
			WHERE v1.case_id IS NOT NULL
			)UNION ALL 
			(SELECT ('http://www.example.org/conference/data/person/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v3.person_id AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m9", CAST(v3.person_id AS TEXT) AS "v4m9"
			FROM (SELECT person_id FROM (

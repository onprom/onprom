			(SELECT ('http://www.example.org/conference/data/person/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v16.person_id AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m8", ('Inviter_' || v17."org_resource") AS "v4m9"
			FROM (SELECT person_id FROM (
			SELECT DISTINCT substring(attr_name FROM 'Result by Reviewer (.*)$') AS person_id
			FROM event_attributes
			WHERE attr_name LIKE 'Result by Reviewer %'
			UNION
			SELECT DISTINCT org_resource AS person_id
			FROM events
			WHERE org_resource IS NOT NULL
			) AS combined_persons) v16, "events" v17
			WHERE (CAST(v16.person_id AS TEXT) = v17."org_resource" AND v16.person_id IS NOT NULL AND v17."org_resource" IS NOT NULL AND 'invite additional reviewer' = v17."concept_name")
			)UNION ALL 
			(SELECT ('http://www.example.org/conference/data/person/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(v19."org_resource", '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m8", ('Author of ' || CAST(v20.case_id AS TEXT)) AS "v4m9"
			FROM "events" v19, (SELECT DISTINCT case_id FROM events) v20
			WHERE (v19."org_resource" = ('Author_' || CAST(v20.case_id AS TEXT)) AND v19."org_resource" IS NOT NULL AND v20.case_id IS NOT NULL AND 'invite additional reviewer' = v19."concept_name")
			)UNION ALL 
			(SELECT ('http://www.example.org/conference/data/person/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(v22."org_resource", '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m8", CAST(v23.person_id AS TEXT) AS "v4m9"
			FROM "events" v22, (SELECT person_id FROM (
			SELECT DISTINCT substring(attr_name FROM 'Result by Reviewer (.*)$') AS person_id
			FROM event_attributes
			WHERE attr_name LIKE 'Result by Reviewer %'
			UNION
			SELECT DISTINCT org_resource AS person_id
			FROM events
			WHERE org_resource IS NOT NULL
			) AS combined_persons) v23
			WHERE (v22."org_resource" = CAST(v23.person_id AS TEXT) AND v22."org_resource" IS NOT NULL AND v23.person_id IS NOT NULL AND 'invite additional reviewer' = v22."concept_name")
			)UNION ALL 
			(SELECT ('http://www.example.org/conference/data/person/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(v25."org_resource", '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2m8", ('Inviter_' || v25."org_resource") AS "v4m9"
			FROM "events" v25
			WHERE (v25."org_resource" IS NOT NULL AND 'invite additional reviewer' = v25."concept_name")
			)) v27
			


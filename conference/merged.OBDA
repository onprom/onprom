source		SELECT DISTINCT ('http://www.example.org/conference/data/assignment/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v1.paper AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D') || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v1.reviewer AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v0", ('http://www.example.org/conference/data/assignment/' || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v2.paper AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D') || REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CAST(v2.reviewer AS TEXT), '%', '%25'), ' ', '%20'), '!', '%21'), '"', '%22'), '#', '%23'), '$', '%24'), '&', '%26'), '''', '%27'), '(', '%28'), ')', '%29'), '*', '%2A'), '+', '%2B'), ',', '%2C'), '/', '%2F'), ':', '%3A'), ';', '%3B'), '<', '%3C'), '=', '%3D'), '>', '%3E'), '?', '%3F'), '@', '%40'), '[', '%5B'), '\', '%5C'), ']', '%5D'), '^', '%5E'), '`', '%60'), '{', '%7B'), '|', '%7C'), '}', '%7D')) AS "v2", CAST(v2.inviter AS TEXT) AS "v3"
			FROM (SELECT
			A.case_id AS paper,
			A.org_resource AS reviewer,
			MIN(
			CASE
			WHEN I.lifecycle_transition = 'start'
			THEN I.time_timestamp
			END
			) AS invite_start,
			MAX(
			CASE
			WHEN I.lifecycle_transition = 'complete'
			THEN I.time_timestamp
			END
			) AS invite_complete,
			MAX(
			CASE
			WHEN I.lifecycle_transition = 'complete'
			THEN I.org_resource
			END
			) AS inviter
			FROM events A
			INNER JOIN event_attributes B
			ON A.event_id = B.event_id
			INNER JOIN events I
			ON A.case_id = I.case_id
			WHERE A.concept_name = 'get review X'
			AND B.attr_name = 'Result by Reviewer X'
			AND A.org_resource IS NOT NULL
			AND I.concept_name = 'invite additional reviewer'
			GROUP BY
			A.case_id,
			A.org_resource) v1, (SELECT
			A.case_id AS paper,
			A.org_resource AS reviewer,
			MIN(
			CASE
			WHEN I.lifecycle_transition = 'start'
			THEN I.time_timestamp
			END
			) AS invite_start,
			MAX(
			CASE
			WHEN I.lifecycle_transition = 'complete'
			THEN I.time_timestamp
			END
			) AS invite_complete,
			MAX(
			CASE
			WHEN I.lifecycle_transition = 'complete'
			THEN I.org_resource
			END
			) AS inviter
			FROM events A
			INNER JOIN event_attributes B
			ON A.event_id = B.event_id
			INNER JOIN events I
			ON A.case_id = I.case_id
			WHERE A.concept_name = 'get review X'
			AND B.attr_name = 'Result by Reviewer X'
			AND A.org_resource IS NOT NULL
			AND I.concept_name = 'invite additional reviewer'
			GROUP BY
			A.case_id,
			A.org_resource) v2
			WHERE (v1.paper IS NOT NULL AND v1.reviewer IS NOT NULL AND v2.paper IS NOT NULL AND v2.reviewer IS NOT NULL AND v2.inviter IS NOT NULL)
			


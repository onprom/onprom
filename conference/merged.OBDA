target		:datadecisionValue/{v0}/final a log:OAttrValue ; log:oValue {v3}^^xsd:anyURI ; log:attrAtTime <http://www.example.com/dolibarr/{v5}/{v0}/{v0}> . <http://www.example.com/dolibarr/decType/decision/{v0}> log:hasOValue :datadecisionValue/{v0}/final . <http://www.example.com/dolibarr/Paper/{v0}/{v0}> log:hasOAttr :datadecisionValue/{v0}/final . 
source		SELECT DISTINCT CAST(v1.paper AS TEXT) AS "v0", CAST(v2.decision AS TEXT) AS "v3", CAST(v3.time AS TEXT) AS "v5"
			FROM (SELECT e_term.case_id AS paper, e_term.org_resource AS noted_by, e_term.time_timestamp AS time, (MAX(CASE WHEN a.attr_name = 'accepts' THEN a.attr_value::int ELSE 0 END) > MAX(CASE WHEN a.attr_name = 'rejects' THEN a.attr_value::int ELSE 0 END)) AS decision FROM events e_term LEFT JOIN events e_decide ON e_term.case_id = e_decide.case_id AND e_decide.concept_name = 'decide' LEFT JOIN event_attributes a ON e_decide.event_id = a.event_id WHERE e_term.concept_name IN ('accept', 'reject') GROUP BY e_term.case_id, e_term.org_resource, e_term.time_timestamp) v1, (SELECT e_term.case_id AS paper, e_term.org_resource AS noted_by, e_term.time_timestamp AS time, (MAX(CASE WHEN a.attr_name = 'accepts' THEN a.attr_value::int ELSE 0 END) > MAX(CASE WHEN a.attr_name = 'rejects' THEN a.attr_value::int ELSE 0 END)) AS decision FROM events e_term LEFT JOIN events e_decide ON e_term.case_id = e_decide.case_id AND e_decide.concept_name = 'decide' LEFT JOIN event_attributes a ON e_decide.event_id = a.event_id WHERE e_term.concept_name IN ('accept', 'reject') GROUP BY e_term.case_id, e_term.org_resource, e_term.time_timestamp) v2, (SELECT e_term.case_id AS paper, e_term.org_resource AS noted_by, e_term.time_timestamp AS time, (MAX(CASE WHEN a.attr_name = 'accepts' THEN a.attr_value::int ELSE 0 END) > MAX(CASE WHEN a.attr_name = 'rejects' THEN a.attr_value::int ELSE 0 END)) AS decision FROM events e_term LEFT JOIN events e_decide ON e_term.case_id = e_decide.case_id AND e_decide.concept_name = 'decide' LEFT JOIN event_attributes a ON e_decide.event_id = a.event_id WHERE e_term.concept_name IN ('accept', 'reject') GROUP BY e_term.case_id, e_term.org_resource, e_term.time_timestamp) v3
			WHERE (CAST(v1.paper AS TEXT) = CAST(v2.paper AS TEXT) AND CAST(v2.paper AS TEXT) = CAST(v3.paper AS TEXT) AND v1.paper IS NOT NULL AND v2.paper IS NOT NULL AND v2.decision IS NOT NULL AND v3.paper IS NOT NULL AND v3.time IS NOT NULL)
			

